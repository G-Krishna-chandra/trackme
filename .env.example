# Optional. Removes the low keyless Google Books quota that otherwise degrades
# search under heavy use. Get one free at https://console.cloud.google.com
# (enable the Books API → create an API key → restrict it to the Books API and
# your HTTP referrer). Copy this file to .env.local and fill in the value.
# The app works WITHOUT this, just rate-limited.
VITE_GOOGLE_BOOKS_KEY=

# Optional. Enables "Sync from Hevy" on the Gym view (requires Hevy Pro). Get a
# key at https://hevy.com/settings?developer. NOTE: no VITE_ prefix — this stays
# server-side via the Vite dev proxy and is NEVER exposed to the browser bundle.
# Works when running `npm run dev`. Copy this file to .env.local and fill it in.
HEVY_API_KEY=

# Build target: 'local' (default) or 'hosted'. Leave unset for normal dev. For a
# static Cloudflare Pages deploy set VITE_DEPLOY_TARGET=hosted (in the Pages
# dashboard, not here) — it drops server-dependent features (Hevy API sync,
# longitood cover proxy) while keeping the rest working with no server.
# VITE_DEPLOY_TARGET=local
